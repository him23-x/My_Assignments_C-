@model List<Department>


<a href="/Department/Add" class="btn btn-success mt-3 mb-3">Create</a>
<table class="table table-hover table-bordered">
	<tr>
		<th>Id</th>
		<th>Name</th>
		<th>Manager Number</th>
	</tr>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.Id</td>
			<td>@item.Name</td>
			<td>@item.MgrName</td>
		</tr>
	}
</table>