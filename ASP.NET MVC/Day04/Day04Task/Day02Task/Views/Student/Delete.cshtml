@model Student

<h1>Deleting Page</h1>

<h2>Are you sure you want to delete this student</h2>

<h3>@Model.Name</h3>
<h3>@Model.Age</h3>

<form method="post" action="/Student/ConfirmDelete/@Model.Id">
	<input type="hidden" name="Id" value="@Model.Id" />
	<input type="submit" value="Delete" class="btn btn-danger" />
</form>

<a href="/Student/ShowAll">Back To List</a>