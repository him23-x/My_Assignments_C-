<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Student Management</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background-color: #f8f9fc;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            width: 250px;
            background: linear-gradient(180deg, #4e73df 10%, #224abe 100%);
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            transition: width 0.3s;
        }

        .sidebar .sidebar-brand {
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.3rem;
            font-weight: 800;
            text-decoration: none;
            letter-spacing: 0.05rem;
            text-transform: uppercase;
        }

        .sidebar .sidebar-brand i {
            margin-right: 8px;
            font-size: 1.5rem;
        }

        .sidebar hr {
            border-top: 1px solid rgba(255,255,255,0.15);
            margin: 0 1rem;
        }

        .sidebar .nav-item {
            position: relative;
        }

        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.2s;
            text-decoration: none;
        }

        .sidebar .nav-link:hover {
            color: #fff;
            background-color: rgba(255,255,255,0.1);
        }

        .sidebar .nav-link.active {
            color: #fff;
            background-color: rgba(255,255,255,0.15);
        }

        .sidebar .nav-link i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
            font-size: 0.9rem;
        }

        .sidebar .sidebar-heading {
            color: rgba(255,255,255,0.4);
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.13rem;
            padding: 1rem 1rem 0.5rem;
        }

        /* ===== CONTENT WRAPPER ===== */
        .content-wrapper {
            margin-left: 250px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            width: calc(100% - 250px);
        }

        /* ===== TOP NAVBAR ===== */
        .topbar {
            height: 70px;
            background-color: #fff;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58,59,69,0.15);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
        }

        .topbar .page-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #5a5c69;
        }

        .topbar .topbar-right {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .topbar .topbar-right .topbar-divider {
            width: 0;
            border-right: 1px solid #e3e6f0;
            height: 40px;
        }

        .topbar .user-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #858796;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .topbar .user-info .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #4e73df;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
        }

        /* ===== MAIN CONTENT ===== */
        .main-content {
            flex: 1;
            padding: 1.5rem;
        }

        .content-card {
            background: #fff;
            border-radius: 0.35rem;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58,59,69,0.1);
            border: none;
            margin-bottom: 1.5rem;
        }

        .content-card .card-header {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
            padding: 0.75rem 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .content-card .card-header h6 {
            color: #4e73df;
            font-weight: 700;
            font-size: 1rem;
            margin: 0;
        }

        .content-card .card-body {
            padding: 1.25rem;
        }

        /* ===== FOOTER ===== */
        .custom-footer {
            background-color: #fff;
            padding: 1.25rem 1.5rem;
            border-top: 1px solid #e3e6f0;
            text-align: center;
            color: #858796;
            font-size: 0.8rem;
        }

        /* ===== TABLE STYLES ===== */
        .table thead th {
            background-color: #4e73df;
            color: #fff;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05rem;
            border: none;
            padding: 0.85rem;
        }

        .table tbody td {
            vertical-align: middle;
            padding: 0.75rem 0.85rem;
            font-size: 0.9rem;
            color: #5a5c69;
        }

        .table-hover tbody tr:hover {
            background-color: #eaecf4;
        }

        /* ===== BUTTON STYLES ===== */
        .btn-action {
            padding: 0.3rem 0.7rem;
            font-size: 0.8rem;
            border-radius: 0.2rem;
            font-weight: 600;
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 768px) {
            .sidebar {
                width: 0;
                overflow: hidden;
            }
            .content-wrapper {
                margin-left: 0;
                width: 100%;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <a class="sidebar-brand" href="/">
            <i class="fas fa-graduation-cap"></i>
            <span>DEPI System</span>
        </a>
        <hr />

        <div class="sidebar-heading">Main</div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home"></i>
                    <span>Dashboard</span>
                </a>
            </li>
        </ul>

        <hr />
        <div class="sidebar-heading">Management</div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Student" asp-action="ShowAll">
                    <i class="fas fa-user-graduate"></i>
                    <span>Students</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Department" asp-action="ShowAllDepts">
                    <i class="fas fa-building"></i>
                    <span>Departments</span>
                </a>
            </li>
        </ul>

        <hr />
        <div class="sidebar-heading">Settings</div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                    <i class="fas fa-shield-alt"></i>
                    <span>Privacy</span>
                </a>
            </li>
        </ul>
    </div>

    <!-- Content Wrapper -->
    <div class="content-wrapper">
        <!-- Topbar -->
        <nav class="topbar">
            <div class="page-title">
                <i class="fas fa-th-large me-2"></i>@(ViewData["Title"] ?? "Dashboard")
            </div>
            <div class="topbar-right">
                <div class="topbar-divider"></div>
                <div class="user-info">
                    <span>Admin User</span>
                    <div class="user-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="main-content">
            @RenderBody()
        </div>

        <!-- Footer -->
        <footer class="custom-footer">
            &copy; @DateTime.Now.Year - <strong>DEPI Student Management System</strong> &mdash; Built with ASP.NET Core MVC
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
