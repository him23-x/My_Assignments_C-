@model Course
@{
    ViewData["Title"] = "Delete Course";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<div class="content-card">
    <div class="card-header">
        <h6><i class="fas fa-exclamation-triangle me-2 text-danger"></i>Delete Course</h6>
    </div>
    <div class="card-body">
        <div class="alert alert-danger">
            <h5>Are you sure you want to delete this course?</h5>
        </div>

        <table class="table">
            <tr>
                <th class="text-muted" style="width: 30%;">Course Name</th>
                <td><strong>@Model.Name</strong></td>
            </tr>
            <tr>
                <th class="text-muted">Full Degree</th>
                <td>@Model.Degree</td>
            </tr>
            <tr>
                <th class="text-muted">Minimum Degree</th>
                <td>@(Model.MinDegree?.ToString() ?? "N/A")</td>
            </tr>
            <tr>
                <th class="text-muted">Department</th>
                <td><span class="badge bg-primary">@(Model.Department?.Name ?? "N/A")</span></td>
            </tr>
        </table>

        <form method="post" action="/Course/ConfirmDelete/@Model.Id">
            <input type="hidden" name="Id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash me-1"></i> Confirm Delete
            </button>
            <a asp-controller="Course" asp-action="ShowAll" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </form>
    </div>
</div>
