@model Course
@{
    ViewData["Title"] = "Course Details";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<div class="content-card">
    <div class="card-header">
        <h6><i class="fas fa-info-circle me-2"></i>Course Details</h6>
        <a asp-controller="Course" asp-action="ShowAll" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back to List
        </a>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <table class="table">
                    <tr>
                        <th class="text-muted" style="width: 40%;">ID</th>
                        <td>@Model.Id</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Course Name</th>
                        <td><strong>@Model.Name</strong></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Full Degree</th>
                        <td>@Model.Degree</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Minimum Degree</th>
                        <td>@(Model.MinDegree?.ToString() ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Department</th>
                        <td><span class="badge bg-primary">@(Model.Department?.Name ?? "N/A")</span></td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="mt-3">
            <a asp-controller="Course" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white">
                <i class="fas fa-edit me-1"></i> Edit
            </a>
            <a asp-controller="Course" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                <i class="fas fa-trash me-1"></i> Delete
            </a>
        </div>
    </div>
</div>
