@model Department

<h2>Add New Department</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Department" asp-action="SaveAdd" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MgrName" class="form-label"></label>
                <input asp-for="MgrName" class="form-control" />
                <span asp-validation-for="MgrName" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary mt-2">Create</button>
            <a asp-controller="Department" asp-action="ShowAllDepts" class="btn btn-secondary mt-2">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}