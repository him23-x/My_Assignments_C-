@model List<Department>

<h2>All Departments</h2>

<a asp-controller="Department" asp-action="Add" class="btn btn-success mt-3 mb-3">Create New</a>

<table class="table table-hover table-bordered">
	<thead>
		<tr>
			<th>Id</th>
			<th>Name</th>
			<th>Manager Name</th>
			<th></th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.Id</td>
				<td>@item.Name</td>
				<td>@item.MgrName</td>
				<td><a asp-controller="Department" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a></td>
				<td><a asp-controller="Department" asp-action="ShowDeptDetials" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a></td>
			</tr>
		}
	</tbody>
</table>