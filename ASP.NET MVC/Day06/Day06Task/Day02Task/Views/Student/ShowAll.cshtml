@model List<Student>
@{
    ViewData["Title"] = "Students";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<!-- Page Header Cards -->
<div class="row mb-4">
    <div class="col-xl-4 col-md-6 mb-3">
        <div class="content-card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem;">Total Students</div>
                        <div class="fw-bold text-primary" style="font-size: 1.5rem;">@Model.Count</div>
                    </div>
                    <div>
                        <i class="fas fa-user-graduate fa-2x text-muted" style="opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Students Table Card -->
<div class="content-card">
    <div class="card-header">
        <h6><i class="fas fa-table me-2"></i>All Students</h6>
        <a asp-controller="Student" asp-action="Add" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i> Add New Student
        </a>
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center py-4">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">No students found. Click "Add New Student" to get started.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Age</th>
                            <th>Department ID</th>
                            <th style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td><strong>@item.Name</strong></td>
                                <td>@item.Age</td>
                                <td><span class="badge bg-primary">@item.DepartmentId</span></td>
                                <td>
                                    <a asp-controller="Student" asp-action="ShowDetails" asp-route-id="@item.Id" class="btn btn-info btn-action text-white">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                    <a asp-controller="Student" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-action text-white">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a asp-controller="Student" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-action">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>